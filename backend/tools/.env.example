# 复制为 backend/tools/.env 并填入真实值（勿提交 git）
#
# ── 推荐：PostgreSQL 自托管（完全离云）──
DATABASE_URL=postgres://funlife:你的密码@127.0.0.1:5432/funlife_vip
HMAC_SECRET=与 local.properties VIP_HMAC_SECRET 一致
AI_API_KEY=sk-...
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat

# ── 旧 CloudBase（仅 export_tcb.js 导出数据时需要）──
TCB_ENV_ID=funlife-prod-d8gxf7og0518b8253
TCB_SECRET_ID=你的 SecretId
TCB_SECRET_KEY=你的 SecretKey

# 管理后台登录（Docker / 本地 npm start 均需）
# 生成密码哈希：cd backend/admin && node hash-password.js <你的密码>
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2a$10$xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ADMIN_SESSION_SECRET=请用 node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" 生成

# 若通过 HTTPS 反代访问，设为 1
ADMIN_COOKIE_SECURE=0

# Docker 映射端口（可选，默认 3300）
# ADMIN_HOST_PORT=3300
