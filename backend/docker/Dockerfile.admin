# FunLife VIP 管理后台
# 构建上下文：backend/
#
#   docker compose build
#   docker compose up -d

FROM node:20-alpine

RUN apk add --no-cache wget

WORKDIR /app

COPY shared ./shared
COPY admin/package.json admin/package-lock.json ./admin/

WORKDIR /app/admin
RUN npm ci --omit=dev

COPY admin/server.js admin/auth.js admin/_loadEnv.js admin/_helpers.js ./
COPY admin/public ./public

ENV NODE_ENV=production
ENV PORT=3300
ENV HOST=0.0.0.0

EXPOSE 3300

HEALTHCHECK --interval=20s --timeout=5s --start-period=15s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3300/login.html >/dev/null || exit 1

CMD ["node", "server.js"]
