# 复制为 pocketbase/.env 后按需修改
# cp docker/.env.example .env

# PocketBase 版本（构建镜像时使用）
PB_VERSION=0.39.0

# 宿主机映射端口（仅本地调试时需要暴露）
PB_HOST_PORT=8090
DRAW_WS_HOST_PORT=8790
PAC_MAZE_WS_HOST_PORT=8791

# Pac-Maze 权威 WebSocket 调优
PAC_MAZE_DISCONNECT_MS=30000
PAC_MAZE_ROOM_GO_MS=8000

# FCM 推送（--profile push 时必填）
# 生成方式: openssl rand -hex 24
FCM_RELAY_KEY=your-random-secret-here
FCM_RELAY_URL=http://fcm-relay:8787/push

# draw_ws 可选鉴权（留空则仅依赖 PB JWT）
DRAW_WS_RELAY_KEY=

# draw_ws 性能调优（一般无需修改）
RING_SIZE=400
MAX_MSG_PER_SEC=240
PB_AUTH_TIMEOUT_MS=4000
DRAW_WS_REPLAY_TAIL=320
DRAW_WS_ROOM_GO_MS=8000
DRAW_WS_LOG_CHUNKS=0

# VIP 管理后台（--profile admin 时必填，见 backend/docker/README.md）
ADMIN_HOST_PORT=3300
TCB_ENV_ID=
TCB_SECRET_ID=
TCB_SECRET_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
ADMIN_COOKIE_SECURE=0
