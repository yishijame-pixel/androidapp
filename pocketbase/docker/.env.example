# 复制为 pocketbase/.env 后按需修改
# cp docker/.env.example .env

PB_VERSION=0.39.0
PB_HOST_PORT=8090
DRAW_WS_HOST_PORT=8790
PAC_MAZE_WS_HOST_PORT=8791
ASSETS_HOST_PORT=8098
API_HOST_PORT=3400
POSTGRES_HOST_PORT=5432

# ── 完全离云（PostgreSQL + funlife-api）──
POSTGRES_PASSWORD=请改为强密码
HMAC_SECRET=与 local.properties VIP_HMAC_SECRET 一致
AI_API_KEY=DeepSeek Key（仅服务端，不进 App）
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat

# VIP 管理后台（--profile admin）
ADMIN_HOST_PORT=3300
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
ADMIN_COOKIE_SECURE=0

