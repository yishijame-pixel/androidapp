<?xml version="1.0" encoding="utf-8"?>
<!--
  🔥 系统窗口背景 = Compose SplashScreen 静态首帧版
  目的：冷启动那一瞬间（Compose 还未渲染时），用户看到的窗口背景
  必须与 Compose SplashScreen 的视觉风格完全一致，做到无缝衔接。
  
  匹配 SplashScreen.kt:
    - 渐变：浅樱粉 → 暖米色 → 浅杏色 → 暖橙
    - Logo：ic_launcher_foreground
    - 居中放置在白色柔光圆盘上
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- ① 背景渐变（与 Compose SplashScreen 一致） -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#FFE4E1"
                android:centerColor="#FFF0E5"
                android:endColor="#FFD6A5"
                android:type="linear" />
        </shape>
    </item>
    
    <!-- ② 浮动装饰圆点 - 左上（淡粉） -->
    <item
        android:top="80dp"
        android:left="30dp"
        android:width="90dp"
        android:height="90dp">
        <shape android:shape="oval">
            <solid android:color="#33FFB6C1" />
        </shape>
    </item>
    
    <!-- ③ 浮动装饰圆点 - 右上（淡橙） -->
    <item
        android:top="140dp"
        android:right="40dp"
        android:width="70dp"
        android:height="70dp">
        <shape android:shape="oval">
            <solid android:color="#33FFCC80" />
        </shape>
    </item>
    
    <!-- ④ 浮动装饰圆点 - 左下（淡黄） -->
    <item
        android:bottom="200dp"
        android:left="50dp"
        android:width="60dp"
        android:height="60dp">
        <shape android:shape="oval">
            <solid android:color="#33FFE0B2" />
        </shape>
    </item>
    
    <!-- ⑤ 浮动装饰圆点 - 右下（淡桃） -->
    <item
        android:bottom="280dp"
        android:right="60dp"
        android:width="80dp"
        android:height="80dp">
        <shape android:shape="oval">
            <solid android:color="#33FFAB91" />
        </shape>
    </item>
    
    <!-- ⑥ Logo 外圈大光晕（径向白光） -->
    <item
        android:gravity="center"
        android:width="220dp"
        android:height="220dp">
        <shape android:shape="oval">
            <gradient
                android:startColor="#80FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="radial"
                android:gradientRadius="110dp" />
        </shape>
    </item>
    
    <!-- ⑦ Logo 内圈柔光圆盘 -->
    <item
        android:gravity="center"
        android:width="170dp"
        android:height="170dp">
        <shape android:shape="oval">
            <gradient
                android:startColor="#FFFFF8E1"
                android:endColor="#FFFFE0B2"
                android:type="radial"
                android:gradientRadius="85dp" />
        </shape>
    </item>
    
    <!-- ⑧ Logo（与 Compose SplashScreen 同款：ic_launcher_foreground） -->
    <item
        android:gravity="center"
        android:width="140dp"
        android:height="140dp"
        android:drawable="@drawable/ic_launcher_foreground" />
    
</layer-list>
