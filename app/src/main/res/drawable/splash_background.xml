<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 主渐变背景 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#FFF8E1"
                android:centerColor="#FFE082"
                android:endColor="#FFB74D"
                android:type="linear"/>
        </shape>
    </item>
    
    <!-- 顶部光晕效果 - 增强 -->
    <item
        android:width="450dp"
        android:height="450dp"
        android:gravity="center_horizontal|top"
        android:top="-180dp">
        <shape android:shape="oval">
            <gradient
                android:startColor="#70FFFFFF"
                android:centerColor="#30FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="radial"
                android:gradientRadius="225dp"/>
        </shape>
    </item>
    
    <!-- 中间光晕效果 - 新增 -->
    <item
        android:width="300dp"
        android:height="300dp"
        android:gravity="center">
        <shape android:shape="oval">
            <gradient
                android:startColor="#20FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="radial"
                android:gradientRadius="150dp"/>
        </shape>
    </item>
    
    <!-- 底部光晕效果 - 增强 -->
    <item
        android:width="400dp"
        android:height="400dp"
        android:gravity="center_horizontal|bottom"
        android:bottom="-120dp">
        <shape android:shape="oval">
            <gradient
                android:startColor="#50FF8A65"
                android:centerColor="#25FF8A65"
                android:endColor="#00FF8A65"
                android:type="radial"
                android:gradientRadius="200dp"/>
        </shape>
    </item>
    
    <!-- 装饰圆点 - 左上大 - 增强透明度 -->
    <item
        android:width="140dp"
        android:height="140dp"
        android:gravity="start|top"
        android:top="30dp"
        android:left="5dp">
        <shape android:shape="oval">
            <gradient
                android:startColor="#35FFB74D"
                android:endColor="#10FFB74D"
                android:type="radial"
                android:gradientRadius="70dp"/>
        </shape>
    </item>
    
    <!-- 装饰圆点 - 左上小 -->
    <item
        android:width="60dp"
        android:height="60dp"
        android:gravity="start|top"
        android:top="70dp"
        android:left="110dp">
        <shape android:shape="oval">
            <gradient
                android:startColor="#40FFCA28"
                android:endColor="#15FFCA28"
                android:type="radial"
                android:gradientRadius="30dp"/>
        </shape>
    </item>
    
    <!-- 装饰圆点 - 右上大 -->
    <item
        android:width="160dp"
        android:height="160dp"
        android:gravity="end|top"
        android:top="90dp"
        android:right="10dp">
        <shape android:shape="oval">
            <gradient
                android:startColor="#30FF8A65"
                android:endColor="#10FF8A65"
                android:type="radial"
                android:gradientRadius="80dp"/>
        </shape>
    </item>
    
    <!-- 装饰圆点 - 右上小 -->
    <item
        android:width="70dp"
        android:height="70dp"
        android:gravity="end|top"
        android:top="40dp"
        android:right="130dp">
        <shape android:shape="oval">
            <gradient
                android:startColor="#45FFD54F"
                android:endColor="#20FFD54F"
                android:type="radial"
                android:gradientRadius="35dp"/>
        </shape>
    </item>
    
    <!-- 装饰圆点 - 左中 -->
    <item
        android:width="90dp"
        android:height="90dp"
        android:gravity="start|center_vertical"
        android:left="20dp">
        <shape android:shape="oval">
            <gradient
                android:startColor="#35FF6B9D"
                android:endColor="#15FF6B9D"
                android:type="radial"
                android:gradientRadius="45dp"/>
        </shape>
    </item>
    
    <!-- 装饰圆点 - 右中 -->
    <item
        android:width="100dp"
        android:height="100dp"
        android:gravity="end|center_vertical"
        android:right="25dp">
        <shape android:shape="oval">
            <gradient
                android:startColor="#40FFB74D"
                android:endColor="#15FFB74D"
                android:type="radial"
                android:gradientRadius="50dp"/>
        </shape>
    </item>
    
    <!-- 装饰圆点 - 左下 -->
    <item
        android:width="95dp"
        android:height="95dp"
        android:gravity="start|bottom"
        android:bottom="170dp"
        android:left="25dp">
        <shape android:shape="oval">
            <gradient
                android:startColor="#40FFD54F"
                android:endColor="#15FFD54F"
                android:type="radial"
                android:gradientRadius="47dp"/>
        </shape>
    </item>
    
    <!-- 装饰圆点 - 右下大 -->
    <item
        android:width="130dp"
        android:height="130dp"
        android:gravity="end|bottom"
        android:bottom="110dp"
        android:right="10dp">
        <shape android:shape="oval">
            <gradient
                android:startColor="#35FFAB40"
                android:endColor="#10FFAB40"
                android:type="radial"
                android:gradientRadius="65dp"/>
        </shape>
    </item>
    
    <!-- 装饰圆点 - 右下小 -->
    <item
        android:width="55dp"
        android:height="55dp"
        android:gravity="end|bottom"
        android:bottom="190dp"
        android:right="110dp">
        <shape android:shape="oval">
            <gradient
                android:startColor="#45FF8A65"
                android:endColor="#20FF8A65"
                android:type="radial"
                android:gradientRadius="27dp"/>
        </shape>
    </item>
    
    <!-- 爪印组 - 左侧 -->
    <item
        android:width="20dp"
        android:height="20dp"
        android:gravity="start|center_vertical"
        android:left="60dp"
        android:top="-120dp">
        <shape android:shape="oval">
            <solid android:color="#30FF6B9D"/>
        </shape>
    </item>
    
    <item
        android:width="24dp"
        android:height="24dp"
        android:gravity="start|center_vertical"
        android:left="95dp"
        android:top="-85dp">
        <shape android:shape="oval">
            <solid android:color="#40FF6B9D"/>
        </shape>
    </item>
    
    <item
        android:width="22dp"
        android:height="22dp"
        android:gravity="start|center_vertical"
        android:left="130dp"
        android:top="-50dp">
        <shape android:shape="oval">
            <solid android:color="#35FF6B9D"/>
        </shape>
    </item>
    
    <!-- 爪印组 - 右侧 -->
    <item
        android:width="22dp"
        android:height="22dp"
        android:gravity="end|center_vertical"
        android:right="60dp"
        android:top="80dp">
        <shape android:shape="oval">
            <solid android:color="#30FF6B9D"/>
        </shape>
    </item>
    
    <item
        android:width="26dp"
        android:height="26dp"
        android:gravity="end|center_vertical"
        android:right="95dp"
        android:top="115dp">
        <shape android:shape="oval">
            <solid android:color="#40FF6B9D"/>
        </shape>
    </item>
    
    <item
        android:width="24dp"
        android:height="24dp"
        android:gravity="end|center_vertical"
        android:right="130dp"
        android:top="150dp">
        <shape android:shape="oval">
            <solid android:color="#35FF6B9D"/>
        </shape>
    </item>
    
    <!-- 星星装饰 - 左上 -->
    <item
        android:width="35dp"
        android:height="35dp"
        android:gravity="start|top"
        android:left="150dp"
        android:top="190dp">
        <shape android:shape="oval">
            <gradient
                android:startColor="#50FFD700"
                android:endColor="#20FFD700"
                android:type="radial"
                android:gradientRadius="17dp"/>
        </shape>
    </item>
    
    <!-- 星星装饰 - 右下 -->
    <item
        android:width="30dp"
        android:height="30dp"
        android:gravity="end|bottom"
        android:right="140dp"
        android:bottom="240dp">
        <shape android:shape="oval">
            <gradient
                android:startColor="#45FFD700"
                android:endColor="#20FFD700"
                android:type="radial"
                android:gradientRadius="15dp"/>
        </shape>
    </item>
    
    <!-- 心形装饰位置 - 左 -->
    <item
        android:width="28dp"
        android:height="28dp"
        android:gravity="start|bottom"
        android:left="80dp"
        android:bottom="280dp">
        <shape android:shape="oval">
            <gradient
                android:startColor="#40FF6B9D"
                android:endColor="#15FF6B9D"
                android:type="radial"
                android:gradientRadius="14dp"/>
        </shape>
    </item>
    
    <!-- 心形装饰位置 - 右 -->
    <item
        android:width="32dp"
        android:height="32dp"
        android:gravity="end|top"
        android:right="70dp"
        android:top="220dp">
        <shape android:shape="oval">
            <gradient
                android:startColor="#45FF6B9D"
                android:endColor="#15FF6B9D"
                android:type="radial"
                android:gradientRadius="16dp"/>
        </shape>
    </item>
</layer-list>
