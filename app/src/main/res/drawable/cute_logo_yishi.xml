    <!-- 额外装饰 - 顶部小星星 -->
    <item
        android:top="8dp"
        android:gravity="center_horizontal"
        android:width="10dp"
        android:height="10dp">
        <shape android:shape="oval">
            <gradient
                android:startColor="#FFEB3B"
                android:endColor="#FDD835"
