<?xml version="1.0" encoding="utf-8"?>
<!-- 超可爱的"一十"Logo - 完美对称版 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- ========== "一"字 ========== -->
    
    <!-- "一"字阴影 -->
    <item
        android:top="33dp"
        android:left="22dp"
        android:right="22dp"
        android:height="20dp">
        <shape android:shape="rectangle">
            <solid android:color="#40000000" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    
    <!-- "一"字主体 - 渐变 -->
    <item
        android:top="28dp"
        android:left="18dp"
        android:right="18dp"
        android:height="20dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#5D4037"
                android:centerColor="#6D4C41"
                android:endColor="#4E342E"
                android:angle="90" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    
    <!-- "一"字顶部高光 -->
    <item
        android:top="29dp"
        android:left="20dp"
        android:right="20dp"
        android:height="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#60FFFFFF" />
            <corners android:topLeftRadius="10dp" android:topRightRadius="10dp" />
        </shape>
    </item>
    
    <!-- "一"字中心高光 -->
    <item
        android:top="32dp"
        android:left="30dp"
        android:width="40dp"
        android:height="8dp">
        <shape android:shape="oval">
            <solid android:color="#90FFFFFF" />
        </shape>
    </item>
    
    <!-- ========== "十"字 - 完美对称版本 ========== -->
    
    <!-- 设计思路：
         容器高度：140dp
         "一"字结束：48dp
         可用空间：48-132dp（84dp）
         横线中心：90dp
         竖线：从55dp到125dp（70dp长），横线正好在中间
    -->
    
    <!-- 竖线阴影 -->
    <item
        android:top="58dp"
        android:gravity="center_horizontal"
        android:width="22dp"
        android:height="70dp">
        <shape android:shape="rectangle">
            <solid android:color="#40000000" />
            <corners android:radius="11dp" />
        </shape>
    </item>
    
    <!-- 竖线主体 - 渐变 -->
    <item
        android:top="55dp"
        android:gravity="center_horizontal"
        android:width="22dp"
        android:height="70dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#5D4037"
                android:centerColor="#6D4C41"
                android:endColor="#4E342E"
                android:angle="0" />
            <corners android:radius="11dp" />
        </shape>
    </item>
    
    <!-- 竖线左侧高光 -->
    <item
        android:top="61dp"
        android:gravity="center_horizontal"
        android:width="5dp"
        android:height="58dp">
        <shape android:shape="rectangle">
            <solid android:color="#60FFFFFF" />
            <corners android:topLeftRadius="11dp" android:bottomLeftRadius="11dp" />
        </shape>
    </item>
    
    <!-- 竖线中心高光 -->
    <item
        android:top="70dp"
        android:gravity="center_horizontal"
        android:width="9dp"
        android:height="45dp">
        <shape android:shape="oval">
            <solid android:color="#90FFFFFF" />
        </shape>
    </item>
    
    <!-- ========== "十"字横线（在竖线正中间：90dp） ========== -->
    
    <!-- 横线阴影 -->
    <item
        android:top="82dp"
        android:left="22dp"
        android:right="22dp"
        android:height="22dp">
        <shape android:shape="rectangle">
            <solid android:color="#40000000" />
            <corners android:radius="11dp" />
        </shape>
    </item>
    
    <!-- 横线主体 - 渐变 -->
    <item
        android:top="79dp"
        android:left="18dp"
        android:right="18dp"
        android:height="22dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#5D4037"
                android:centerColor="#6D4C41"
                android:endColor="#4E342E"
                android:angle="90" />
            <corners android:radius="11dp" />
        </shape>
    </item>
    
    <!-- 横线顶部高光 -->
    <item
        android:top="80dp"
        android:left="20dp"
        android:right="20dp"
        android:height="5dp">
        <shape android:shape="rectangle">
            <solid android:color="#60FFFFFF" />
            <corners android:topLeftRadius="11dp" android:topRightRadius="11dp" />
        </shape>
    </item>
    
    <!-- 横线中心高光 -->
    <item
        android:top="83dp"
        android:left="30dp"
        android:width="45dp"
        android:height="9dp">
        <shape android:shape="oval">
            <solid android:color="#90FFFFFF" />
        </shape>
    </item>
    
