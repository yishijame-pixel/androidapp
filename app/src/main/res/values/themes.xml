<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 启动主题 - 立即显示启动页面背景 -->
    <style name="Theme.FunLife.Splash" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_screen_layer</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <!-- 状态/导航栏色匹配新 splash 渐变（顶 #FFE4E1 / 底 #FFD6A5） -->
        <item name="android:statusBarColor">#FFE4E1</item>
        <item name="android:navigationBarColor">#FFD6A5</item>
    </style>
    
    <!-- 主题 -->
    <style name="Theme.FunLife" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#FFFFFFFF</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <!-- SuperTux SDL：渐变背景 + 切到全屏，启动瞬间即有视觉反馈 -->
    <style name="Theme.FunLife.SuperTuxClassic" parent="android:Theme.NoTitleBar.Fullscreen">
        <item name="android:windowBackground">@drawable/supertux_loading_background</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:statusBarColor">#1B263B</item>
        <item name="android:navigationBarColor">#0D1B2A</item>
    </style>
</resources>
