/**
 * 金币雨效果
 */
@Composable
fun CoinRainEffect() {
    val coins = remember {
        List(30) {
            CoinParticle(
                startX = Random.nextFloat(),
                delay = Random.nextInt(0, 2000),
                duration = Random.nextInt(2000, 4000)
            )
        }
    }
    
    coins.forEach { coin ->
        FallingCoin(coin)
    }
}

data class CoinParticle(
    val startX: Float,
    val delay: Int,
    val duration: Int
)

@Composable
fun FallingCoin(particle: CoinParticle) {
    val infiniteTransition = rememberInfiniteTransition(label = "coin")
    
    val offsetY by infiniteTransition.animateFloat(
        initialValue = -100f,
        targetValue = 1000f,
        animationSpec = infiniteRepeatable(
            animation = tween(
                durationMillis = particle.duration,
                delayMillis = particle.delay,
                easing = LinearEasing
            ),
            repeatMode = RepeatMode.Restart
        ),
        label = "offsetY"
    )
    
    val rotation by infiniteTransition.animateFloat(
        initialValue = 0f,
        targetValue = 360f,
        animationSpec = infiniteRepeatable(
            animation = tween(
                durationMillis = 1000,
                easing = LinearEasing
            ),
            repeatMode = RepeatMode.Restart
        ),
        label = "rotation"
    )
    
    Box(
        modifier = Modifier
            .fillMaxSize()
    ) {
        Text(
            text = "🪙",
            fontSize = 32.sp,
            modifier = Modifier
                .offset(
                    x = (particle.startX * 350).dp,
                    y = offsetY.dp
                )
                .graphicsLayer {
                    rotationZ = rotation
                }
        )
    }
}

/**
 * 背景粒子效果
 */
@Composable
fun VipBackgroundParticles(vipLevel: VipLevel) {
    val particles = remember {
        List(40) {
            FloatingBackgroundParticle(
                startX = Random.nextFloat(),
                startY = Random.nextFloat(),
                size = Random.nextFloat() * 4f + 2f,
                duration = Random.nextInt(3000, 6000),
                delay = Random.nextInt(0, 2000)
            )
        }
    }
    
    val colors = when (vipLevel) {
        VipLevel.VIP3 -> listOf(Color(0xFFFFD700), Color(0xFFFF00FF), Color(0xFF00D9FF))
        VipLevel.VIP2 -> listOf(Color(0xFF00D9FF), Color(0xFF6B5FFF), Color(0xFF00FFD9))
        VipLevel.VIP1 -> listOf(Color(0xFFFFD700), Color(0xFFFFB800), Color(0xFFFF9500))
        else -> listOf(Color.White)
    }
    
    particles.forEach { particle ->
        AnimatedBackgroundParticle(particle, colors.random())
    }
}

data class FloatingBackgroundParticle(
    val startX: Float,
    val startY: Float,
    val size: Float,
    val duration: Int,
    val delay: Int
)

@Composable
fun AnimatedBackgroundParticle(particle: FloatingBackgroundParticle, color: Color) {
    val infiniteTransition = rememberInfiniteTransition(label = "particle")
    
    val offsetY by infiniteTransition.animateFloat(
        initialValue = particle.startY * 1000f,
        targetValue = particle.startY * 1000f - 300f,
        animationSpec = infiniteRepeatable(
            animation = tween(
                durationMillis = particle.duration,
                delayMillis = particle.delay,
                easing = LinearEasing
            ),
            repeatMode = RepeatMode.Reverse
        ),
        label = "offsetY"
    )
    
    val alpha by infiniteTransition.animateFloat(
        initialValue = 0.3f,
        targetValue = 0.8f,
        animationSpec = infiniteRepeatable(
            animation = tween(
                durationMillis = 1500,
                easing = FastOutSlowInEasing
            ),
            repeatMode = RepeatMode.Reverse
        ),
        label = "alpha"
    )
    
    Canvas(
        modifier = Modifier
            .fillMaxSize()
    ) {
        drawCircle(
            color = color.copy(alpha = alpha),
            radius = particle.size.dp.toPx(),
            center = Offset(
                particle.startX * size.width,
                offsetY
            )
        )
    }
}

/**
 * 彩虹光波扩散效果 - 修复版（不使用Stroke）
 */
@Composable
fun RainbowWaveEffect(vipLevel: VipLevel) {
    val infiniteTransition = rememberInfiniteTransition(label = "rainbow")
    
    val scale by infiniteTransition.animateFloat(
        initialValue = 0.5f,
        targetValue = 3f,
        animationSpec = infiniteRepeatable(
            animation = tween(2000, easing = LinearEasing),
            repeatMode = RepeatMode.Restart
        ),
        label = "scale"
    )
    
    val alpha by infiniteTransition.animateFloat(
        initialValue = 0.6f,
        targetValue = 0f,
        animationSpec = infiniteRepeatable(
            animation = tween(2000, easing = LinearEasing),
            repeatMode = RepeatMode.Restart
        ),
        label = "alpha"
    )
    
    val colors = when (vipLevel) {
        VipLevel.VIP3 -> listOf(
            Color(0xFFFFD700),
            Color(0xFFFF00FF),
            Color(0xFF00D9FF)
        )
        VipLevel.VIP2 -> listOf(
            Color(0xFF00D9FF),
            Color(0xFF6B5FFF),
            Color(0xFF9D4FFF)
        )
        else -> listOf(
            Color(0xFFFFD700),
            Color(0xFFFFB800),
            Color(0xFFFF9500)
        )
    }
    
    Canvas(modifier = Modifier.fillMaxSize()) {
        val centerX = size.width / 2
        val centerY = size.height / 2
        
        repeat(5) { layer ->
            val layerScale = scale + layer * 0.2f
            val layerAlpha = (alpha * (1f - layer * 0.15f)).coerceAtLeast(0f)
            
            // 使用实心圆而不是Stroke
            drawCircle(
                brush = Brush.radialGradient(
                    colors = colors.map { it.copy(alpha = layerAlpha * 0.3f) },
                    center = Offset(centerX, centerY),
                    radius = 150.dp.toPx() * layerScale
                ),
                radius = 150.dp.toPx() * layerScale,
                center = Offset(centerX, centerY)
            )
        }
    }
}

/**
 * 爆炸粒子效果
 */
@Composable
fun ExplosionParticles(vipLevel: VipLevel) {
    val particles = remember {
        List(80) {
            ExplosionParticle(
                angle = Random.nextFloat() * 360f,
                speed = Random.nextFloat() * 300f + 100f,
                size = Random.nextFloat() * 6f + 3f,
                delay = Random.nextInt(0, 500)
            )
        }
    }
    
    val colors = when (vipLevel) {
        VipLevel.VIP3 -> listOf(Color(0xFFFFD700), Color(0xFFFF00FF), Color(0xFF00D9FF))
        VipLevel.VIP2 -> listOf(Color(0xFF00D9FF), Color(0xFF6B5FFF), Color(0xFF00FFD9))
        else -> listOf(Color(0xFFFFD700), Color(0xFFFFB800), Color(0xFFFF9500))
    }
    
    particles.forEach { particle ->
        AnimatedExplosionParticle(particle, colors.random())
    }
}

data class ExplosionParticle(
    val angle: Float,
    val speed: Float,
    val size: Float,
    val delay: Int
)

@Composable
fun AnimatedExplosionParticle(particle: ExplosionParticle, color: Color) {
    val infiniteTransition = rememberInfiniteTransition(label = "explosion")
    
    val distance by infiniteTransition.animateFloat(
        initialValue = 0f,
        targetValue = particle.speed,
        animationSpec = infiniteRepeatable(
            animation = tween(
                durationMillis = 1500,
                delayMillis = particle.delay,
                easing = FastOutSlowInEasing
            ),
            repeatMode = RepeatMode.Restart
        ),
        label = "distance"
    )
    
    val alpha by infiniteTransition.animateFloat(
        initialValue = 1f,
        targetValue = 0f,
        animationSpec = infiniteRepeatable(
            animation = tween(
                durationMillis = 1500,
                delayMillis = particle.delay,
                easing = LinearEasing
            ),
            repeatMode = RepeatMode.Restart
        ),
        label = "alpha"
    )
    
    val angleRad = particle.angle * (PI / 180f).toFloat()
    val offsetX = cos(angleRad) * distance
    val offsetY = sin(angleRad) * distance
    
    Canvas(modifier = Modifier.fillMaxSize()) {
        val centerX = size.width / 2
        val centerY = size.height / 2
        
        drawCircle(
            color = color.copy(alpha = alpha.coerceAtLeast(0f)),
            radius = particle.size.dp.toPx(),
            center = Offset(centerX + offsetX, centerY + offsetY)
        )
    }
}

/**
 * 震撼光环效果 - 修复版（不使用Stroke）
 */
@Composable
fun ShockwaveRings(vipLevel: VipLevel) {
    val infiniteTransition = rememberInfiniteTransition(label = "shockwave")
    
    val scale by infiniteTransition.animateFloat(
        initialValue = 1f,
        targetValue = 2.5f,
        animationSpec = infiniteRepeatable(
            animation = tween(1200, easing = FastOutSlowInEasing),
            repeatMode = RepeatMode.Restart
        ),
        label = "scale"
    )
    
    val alpha by infiniteTransition.animateFloat(
        initialValue = 0.7f,
        targetValue = 0f,
        animationSpec = infiniteRepeatable(
            animation = tween(1200, easing = LinearEasing),
            repeatMode = RepeatMode.Restart
        ),
        label = "alpha"
    )
    
    val color = when (vipLevel) {
        VipLevel.VIP3 -> Color(0xFFFFD700)
        VipLevel.VIP2 -> Color(0xFF00D9FF)
        else -> Color(0xFFFFB800)
    }
    
    Canvas(modifier = Modifier.size(400.dp)) {
        val centerX = size.width / 2
        val centerY = size.height / 2
        
        repeat(3) { ring ->
            val ringScale = scale + ring * 0.3f
            val ringAlpha = (alpha * (1f - ring * 0.25f)).coerceAtLeast(0f)
            
            // 使用实心圆而不是Stroke
            drawCircle(
                brush = Brush.radialGradient(
                    colors = listOf(
                        color.copy(alpha = ringAlpha * 0.5f),
                        color.copy(alpha = ringAlpha * 0.3f),
                        Color.Transparent
                    ),
                    center = Offset(centerX, centerY),
                    radius = 100.dp.toPx() * ringScale
                ),
                radius = 100.dp.toPx() * ringScale,
                center = Offset(centerX, centerY)
            )
        }
    }
}

/**
 * 超级光芒爆发效果
 */
@Composable
fun SuperRadiantBurst(vipLevel: VipLevel) {
    val infiniteTransition = rememberInfiniteTransition(label = "superBurst")
    
    val rotation by infiniteTransition.animateFloat(
        initialValue = 0f,
        targetValue = 360f,
        animationSpec = infiniteRepeatable(
            animation = tween(4000, easing = LinearEasing),
            repeatMode = RepeatMode.Restart
        ),
        label = "rotation"
    )
    
    val pulse by infiniteTransition.animateFloat(
        initialValue = 0.8f,
        targetValue = 1.2f,
        animationSpec = infiniteRepeatable(
            animation = tween(1000, easing = FastOutSlowInEasing),
            repeatMode = RepeatMode.Reverse
        ),
        label = "pulse"
    )
    
    val colors = when (vipLevel) {
        VipLevel.VIP3 -> listOf(Color(0xFFFFD700), Color(0xFFFF00FF))
        VipLevel.VIP2 -> listOf(Color(0xFF00D9FF), Color(0xFF6B5FFF))
        else -> listOf(Color(0xFFFFD700), Color(0xFFFF9500))
    }
    
    Canvas(modifier = Modifier.fillMaxSize()) {
        rotate(rotation) {
            val centerX = size.width / 2
            val centerY = size.height / 2
            
            repeat(24) { index ->
                val angle = (index * 15f) * (PI / 180f).toFloat()
                val length = 200.dp.toPx() * pulse
                
                val endX = centerX + cos(angle) * length
                val endY = centerY + sin(angle) * length
                
                drawLine(
                    brush = Brush.linearGradient(
                        colors = listOf(
                            colors[index % colors.size].copy(alpha = 0.9f),
                            colors[(index + 1) % colors.size].copy(alpha = 0.5f),
                            Color.Transparent
                        ),
                        start = Offset(centerX, centerY),
                        end = Offset(endX, endY)
                    ),
                    start = Offset(centerX, centerY),
                    end = Offset(endX, endY),
                    strokeWidth = 6.dp.toPx()
                )
            }
        }
    }
}

/**
 * 烟花爆炸效果
 */
@Composable
fun FireworksExplosion(vipLevel: VipLevel) {
    val fireworks = remember {
        listOf(
            FireworkData(0.2f, 0.3f, 0),
            FireworkData(0.8f, 0.25f, 500),
            FireworkData(0.5f, 0.6f, 1000),
            FireworkData(0.15f, 0.7f, 1500),
            FireworkData(0.85f, 0.65f, 2000),
            FireworkData(0.5f, 0.35f, 2500)
        )
    }
    
    val colors = when (vipLevel) {
        VipLevel.VIP3 -> listOf(Color(0xFFFFD700), Color(0xFFFF00FF), Color(0xFF00D9FF))
        VipLevel.VIP2 -> listOf(Color(0xFF00D9FF), Color(0xFF6B5FFF), Color(0xFF9D4FFF))
        else -> listOf(Color(0xFFFFD700), Color(0xFFFFB800), Color(0xFFFF9500))
    }
    
    fireworks.forEach { firework ->
        SingleFirework(firework, colors.random())
    }
}

data class FireworkData(
    val x: Float,
    val y: Float,
    val delay: Int
)

@Composable
fun SingleFirework(firework: FireworkData, color: Color) {
    val infiniteTransition = rememberInfiniteTransition(label = "firework")
    
    val scale by infiniteTransition.animateFloat(
        initialValue = 0f,
        targetValue = 1.5f,
        animationSpec = infiniteRepeatable(
            animation = tween(
                durationMillis = 1000,
                delayMillis = firework.delay,
                easing = FastOutSlowInEasing
            ),
            repeatMode = RepeatMode.Restart
        ),
        label = "scale"
    )
    
    val alpha by infiniteTransition.animateFloat(
        initialValue = 1f,
        targetValue = 0f,
        animationSpec = infiniteRepeatable(
            animation = tween(
                durationMillis = 1000,
                delayMillis = firework.delay,
                easing = LinearEasing
            ),
            repeatMode = RepeatMode.Restart
        ),
        label = "alpha"
    )
    
    Canvas(modifier = Modifier.fillMaxSize()) {
        val centerX = size.width * firework.x
        val centerY = size.height * firework.y
        
        repeat(16) { index ->
            val angle = (index * 22.5f) * (PI / 180f).toFloat()
            val length = 80.dp.toPx() * scale
            
            val endX = centerX + cos(angle) * length
            val endY = centerY + sin(angle) * length
            
            drawLine(
                brush = Brush.linearGradient(
                    colors = listOf(
                        color.copy(alpha = alpha.coerceAtLeast(0f)),
                        Color.Transparent
                    ),
                    start = Offset(centerX, centerY),
                    end = Offset(endX, endY)
                ),
                start = Offset(centerX, centerY),
                end = Offset(endX, endY),
                strokeWidth = 4.dp.toPx()
            )
            
            // 烟花粒子
            drawCircle(
                color = color.copy(alpha = alpha.coerceAtLeast(0f)),
                radius = 4.dp.toPx(),
                center = Offset(endX, endY)
            )
        }
    }
}

/**
 * 超级金币奖励动画 - 全新简洁版
 */
@Composable
fun SuperCoinRewardAnimation(coins: Int, vipLevel: VipLevel) {
    val infiniteTransition = rememberInfiniteTransition(label = "superCoin")
    
    val bounce by infiniteTransition.animateFloat(
        initialValue = 0f,
        targetValue = -25f,
        animationSpec = infiniteRepeatable(
            animation = tween(1000, easing = FastOutSlowInEasing),
            repeatMode = RepeatMode.Reverse
        ),
        label = "bounce"
    )
    
    val scale by infiniteTransition.animateFloat(
        initialValue = 0.95f,
        targetValue = 1.05f,
        animationSpec = infiniteRepeatable(
            animation = tween(800, easing = FastOutSlowInEasing),
            repeatMode = RepeatMode.Reverse
        ),
        label = "scale"
    )
    
    Box(
        modifier = Modifier
            .offset(y = bounce.dp)
            .scale(scale)
    ) {
        // 超强光晕背景
        Canvas(modifier = Modifier.size(450.dp)) {
            val centerX = size.width / 2
            val centerY = size.height / 2
            
            repeat(8) { layer ->
                val radius = 100.dp.toPx() + layer * 35.dp.toPx()
                drawCircle(
                    brush = Brush.radialGradient(
                        colors = listOf(
                            Color(0xFFFFD700).copy(alpha = 0.7f - layer * 0.08f),
                            Color(0xFFFF9500).copy(alpha = 0.5f - layer * 0.06f),
